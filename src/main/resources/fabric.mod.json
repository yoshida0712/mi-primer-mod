{
	"schemaVersion": 1,
	"id": "miprimermod",
	"version": "${version}",
	"name": "Mi Primer Mod",
	"description": "Mi primer mod de Minecraft hecho con Fabric.",
	"authors": [
		"Salim David"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/miprimermod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.miprimermod.MiPrimerMod"
		],
		"client": [
			"com.miprimermod.client.MiPrimerModClient"
		]
	},
	"mixins": [
		"miprimermod.mixins.json",
		{
			"config": "miprimermod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
